# Cœur Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=unabsences.example.com,www.unabsences.example.com
CSRF_TRUSTED_ORIGINS=https://unabsences.example.com,https://www.unabsences.example.com

# Reverse proxy / HTTPS
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=False
# Ne faire confiance qu'aux IP privées du reverse proxy, pas aux plages RFC1918 complètes.
TRUSTED_PROXY_CIDRS=172.30.0.10/32
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Cache distribué / rate limit (Redis)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/1
REDIS_MAX_CONNECTIONS=100
REDIS_CACHE_TIMEOUT=300

# Limites de débit
HEALTHCHECK_RATE_LIMIT=12/m
LOGIN_RATE_LIMIT_IP=20/5m
LOGIN_RATE_LIMIT_COMBINED=5/5m

# Protection du health check
HEALTHCHECK_TOKEN=replace-with-strong-healthcheck-token
# Fenêtre de rotation facultative (token(s) précédent(s) séparés par des virgules)
HEALTHCHECK_TOKEN_PREVIOUS=
# N'autoriser que les IP du monitoring et de localhost à appeler /api/health/
HEALTHCHECK_ALLOWLIST_CIDRS=127.0.0.1/32,::1/128,172.30.0.14/32

# Base de données
DB_NAME=gestion_absences_universite
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
POSTGRES_PASSWORD=change-me

# Domaine (utilisé par nginx + scripts SSL)
DOMAIN=unabsences.example.com

# Email (SMTP Gmail avec mot de passe d'application)
# Pour générer un mot de passe d'application Gmail :
#   1. Activer la validation en deux étapes sur https://myaccount.google.com/security
#   2. Aller dans Mots de passe d'application → en créer un nommé « UniAbsences »
#   3. Copier le mot de passe à 16 caractères dans EMAIL_HOST_PASSWORD
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=UniAbsences Notification System <your_email@gmail.com>

# Validité du token de réinitialisation de mot de passe (en secondes, par défaut : 3600 = 1 heure)
PASSWORD_RESET_TIMEOUT=3600

# Auth basique du monitoring (Uptime Kuma sur /monitoring)
MONITORING_USER=admin
MONITORING_PASSWORD=change-me
